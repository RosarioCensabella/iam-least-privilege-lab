# Terraform local directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform plan files
*.tfplan
*.tfplan.*
*.plan

# Terraform variable files with real values
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform backend config with real environment values
terraform/envs/*/backend.hcl
!terraform/envs/*/backend.hcl.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# Local environment and credential files
.env
.env.*
aws-credentials*
*.pem
*.key

# Local test files
terraform/envs/dev/data-analyst-policy.json
terraform/envs/dev/sample-report.txt
terraform/envs/dev/downloaded-sample-report.txt
terraform/envs/dev/internal-evidence.txt
terraform/envs/dev/unauthorized-upload.txt
terraform/envs/dev/cloudtrail-assume-role-events.json

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/