# Terraform local files
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files with real values
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment files
.env
.env.*
aws-credentials*
*.pem
*.key

# OS / editor files
.DS_Store
.vscode/
.idea/

# Terraform plan files
*.tfplan
*.plan